.PHONY : tests/NPCFactoryTest.o

# target to build an object file
tests/NPCFactoryTest.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/runTests.dir/build.make CMakeFiles/runTests.dir/tests/NPCFactoryTest.cpp.o
.PHONY : tests/NPCFactoryTest.cpp.o

tests/NPCFactoryTest.i: tests/NPCFactoryTest.cpp.i
.PHONY : tests/NPCFactoryTest.i

# target to preprocess a source file
tests/NPCFactoryTest.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/runTests.dir/build.make CMakeFiles/runTests.dir/tests/NPCFactoryTest.cpp.i
.PHONY : tests/NPCFactoryTest.cpp.i

tests/NPCFactoryTest.s: tests/NPCFactoryTest.cpp.s
.PHONY : tests/NPCFactoryTest.s

# target to generate assembly for a file
tests/NPCFactoryTest.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/runTests.dir/build.make CMakeFiles/runTests.dir/tests/NPCFactoryTest.cpp.s
.PHONY : tests/NPCFactoryTest.cpp.s

